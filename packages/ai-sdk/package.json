{
  "name": "@spear/ai-sdk",
  "version": "1.0.0",
  "description": "SPEAR integration for Vercel AI SDK - Multi-provider LLM security",
  "license": "Apache-2.0",
  "author": "Sunny Patneedi <sunny@saymake.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/sunnypatneedi/spear.git",
    "directory": "packages/ai-sdk"
  },
  "homepage": "https://github.com/sunnypatneedi/spear#readme",
  "bugs": {
    "url": "https://github.com/sunnypatneedi/spear/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts'"
  },
  "peerDependencies": {
    "@spear/core": "^1.0.0",
    "ai": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/anthropic": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.12.12",
    "vitest": "^1.6.0",
    "eslint": "^9.9.0"
  },
  "keywords": [
    "spear",
    "vercel-ai-sdk",
    "gemini",
    "openai",
    "anthropic",
    "llm-security",
    "prompt-protection",
    "multi-provider"
  ]
}
